# Public browser configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API configuration
VENDORLENS_ENVIRONMENT=development
VENDORLENS_CORS_ORIGINS=["http://localhost:3000"]
VENDORLENS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
VENDORLENS_SUPABASE_URL=http://127.0.0.1:54321
VENDORLENS_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
VENDORLENS_STORAGE_BUCKET=vendor-documents
VENDORLENS_QUEUE_NAME=example_jobs
VENDORLENS_TRUST_PROXY_HEADERS=false
VENDORLENS_REQUEST_LIMIT=5
VENDORLENS_REQUEST_WINDOW_SECONDS=60
VENDORLENS_QUEUE_DEPTH_LIMIT=100

# Worker configuration
VENDORLENS_VISIBILITY_TIMEOUT_SECONDS=30
VENDORLENS_MAX_ATTEMPTS=3
VENDORLENS_POLL_INTERVAL_SECONDS=1
VENDORLENS_SHUTDOWN_GRACE_SECONDS=20

# Local Compose bridge values are populated by scripts/dev.ps1
VENDORLENS_CONTAINER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres
VENDORLENS_CONTAINER_SUPABASE_URL=http://host.docker.internal:54321
